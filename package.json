{
  "name": "cambodia-3d-map",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive 3D map of Cambodia with turn-by-turn 3D navigation in the browser.",
  "scripts": {
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "dev": "next dev",
    "dev:phone": "next dev --experimental-https -H 0.0.0.0",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mapbox/vector-tile": "3.0.0",
    "maplibre-gl": "6.16.0",
    "next": "16.4.3",
    "pbf": "5.1.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "7.0.2"
  }
}
